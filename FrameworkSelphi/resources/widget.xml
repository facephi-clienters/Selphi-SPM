<?xml version="1.0" encoding="UTF-8"?>
<facephi-widget-conf version="1.1"
    color_warning_message="#EB184C"
    font_warning_message="Poppins-SemiBold.ttf"
    color_shutter="#00819880"
    color_shutter_text="#FFFFFF"
    font_shutter_text="Poppins-SemiBold.ttf"
    font_shutter_size="35.0"
    color_quality_low="#EB184C"
    color_quality_good="#ffab41"
    color_quality_excellent="#40b305"
    color_progress_bar="#604FC6"
    width_progress_bar="6.0">
    

    <view id="StartExtractor">
        <background id="background"
        top="#FFFFFF"
        middle_top="#FFFFFF"
        middle_bottom="#FFFFFF"
        bottom="#FFFFFF"
        mirror_mist_color="#FFFFFF80"
        />
        
        <title id="title"
        content="LogoMedium.png"
        content_type="RESOURCE_ID"
        />

        <text id="text"
        color="#2B303C"
        font="Poppins-SemiBold.ttf"
        font_size="20.0"
        />
        
        <camera id="camera" />
        
        <button id="button_start"
        background="#604FC6"
        decorator="#604FC6"
        foreground="#FFFFFF"
        content="button_start"
        content_type="TEXT_ID"
        font="Poppins-SemiBold.ttf"
        font_size="16.0"
        align="CENTER"
        />
        
        <buttonImage id="button_info" value="InfoBlack.png"/>
        
        <buttonImage id="button_exit" value="CrossBlack.png"/>
        
        <image id="logo_medium" value=""/>
    </view>

    <view id="Extractor">
        <background id="background"
        top="#FFFFFF"
        middle_top="#FFFFFF"
        middle_bottom="#FFFFFF"
        bottom="#FFFFFF"
        />
        
        <title id="title"
        content="LogoMedium.png"
        content_type="RESOURCE_ID"
        />
                
        <camera id="camera" />

        <video id="extraction_video" mode="Normal"
        value="PuppetBoyBeard.mp4, PuppetBoyGlasses.mp4, PuppetBoyNormal.mp4,PuppetGirlAfro.mp4, PuppetGirlGlasses.mp4, PuppetGirlNormal.mp4"
        />
        
        <text id="text" mode="Normal"
        color="#2B303C"
        font="Poppins-SemiBold.ttf"
        font_size="20.0"
        />

        <text id="warning" mode="Warning"
        color="#EB184C"
        font="Poppins-SemiBold.ttf"
        font_size="20.0"
        />

        <buttonImage id="button_exit" value="CrossBlack.png"/>
        
        <image id="logo_medium" value=""/>
    </view>

    <view id="LivenessMove">
        <background id="background"
        top="#FFFFFF"
        middle_top="#FFFFFF"
        middle_bottom="#FFFFFF"
        bottom="#FFFFFF"
        />
        
        <title id="title"
        content="LogoMedium.png"
        content_type="RESOURCE_ID"
        />
                
        <camera id="camera" />
        
        <animation id="liveness_move" name="ArrowProgressExpulsion_" ext="png" start="01" end="36"/>
        <waiting id="waiting" color="#2B303C"/>
        
        <text id="liveness_move_text" mode="Normal"
        color="#2B303C"
        font="Poppins-SemiBold.ttf"
        font_size="20.0"
        />
        
        <text id="warning" mode="Warning"
        color="#EB184C"
        font="Poppins-SemiBold.ttf"
        font_size="20.0"
        />
        
        <buttonImage id="button_exit" value="CrossBlack.png"/>
        
        <image id="logo_medium" value=""/>
    </view>

    <view id="ScanQR">
        <background id="background"
        top="#FFFFFF"
        middle_top="#FFFFFF"
        middle_bottom="#FFFFFF"
        bottom="#FFFFFF"
        />
        
        <title id="title"
        content="LogoMedium.png"
        content_type="RESOURCE_ID"
        />
                
        <camera id="camera" />
        
        <text id="text" mode="Normal"
        color="#2B303C"
        font="Poppins-SemiBold.ttf"
        font_size="20.0"
        />
        
        <text id="warning" mode="Warning"
        color="#EB184C"
        font="Poppins-SemiBold.ttf"
        font_size="20.0"
        />

        <fade id="qr_fade" target_color="#FFFFFF"/>

        <buttonImage id="button_exit" value="CrossBlack.png"/>
        
        <image id="logo_medium" value=""/>
    </view>

    <view id="Results">
        <background id="background"
        top="#FFFFFF"
        middle_top="#FFFFFF"
        middle_bottom="#FFFFFF"
        bottom="#FFFFFF"
        mirror_color="#f9f9f9"
        />
        
        <title id="title"
        content="LogoMedium.png"
        content_type="RESOURCE_ID"
        />
                
        <text id="tip"
        color="#2B303C"
        font="Poppins-SemiBold.ttf"
        font_size="20.0"
        />
        
        <results id="results"
        background_color="#F9F9F9"
        fontResult="Poppins-SemiBold.ttf"
        fontResult_size="30.0"
        fontQuality="Poppins-SemiBold.ttf"
        fontQuality_size="17.0"
        />
        
        <button id="button_repeat"
        background="#ffffff"
        decorator="#1D2C4D"
        foreground="#604FC6"
        content="button_repeat"
        content_type="TEXT_ID"
        font="Poppins-SemiBold.ttf"
        font_size="16.0"
        align="CENTER"
        type="FLAT_WITH_BORDER"
        radius="500"
        />
        
        <button id="button_finish"
        background="#604FC6"
        decorator="#604FC6"
        foreground="#FFFFFF"
        content="button_finish"
        content_type="TEXT_ID"
        font="Poppins-SemiBold.ttf"
        font_size="16.0"
        align="CENTER"
        type="FLAT_WITH_BORDER"
        radius="500"
        />
        
        <image id="logo_medium" value=""/>
    </view>

    <view id="Success">
        <background id="background"
